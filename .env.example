# DocMe local environment.
#
# Copy to .env and edit. .env is gitignored — never commit real credentials.
#   Copy-Item .env.example .env
#
# These values are for LOCAL DEVELOPMENT ONLY. The same variable names are used
# against hosted Supabase in staging/production, but with the real secrets.

# ---------------------------------------------------------------------------
# Local database (the container in docker/compose.yaml)
# ---------------------------------------------------------------------------

# Host-published port. Deliberately not 5432, so we do not collide with a
# Postgres you may already be running on the host.
POSTGRES_PORT=54329

POSTGRES_DB=docme
POSTGRES_USER=docme_app
POSTGRES_PASSWORD=change_me_local_only

# Connection string for the Dart/Flutter side. Note this uses 127.0.0.1,
# because the app runs on your host, not inside the compose network.
# The `db` hostname only resolves from another container.
#
# If a password contains characters that need URL encoding (@ : / ? # [ ]),
# percent-encode it or the connection will fail to parse.
SUPABASE_URL=http://127.0.0.1:54329
SUPABASE_ANON_KEY=local_dev_anon_key
DATABASE_URL=postgres://docme_app:change_me_local_only@127.0.0.1:54329/docme

# ---------------------------------------------------------------------------
# Container isolation
# ---------------------------------------------------------------------------

# Compose project name. Change this to run a second, fully isolated copy of the
# stack alongside this one (different containers, volumes and ports):
#   docker compose -p docme-b -f docker/compose.yaml up -d db
COMPOSE_PROJECT_NAME=docme